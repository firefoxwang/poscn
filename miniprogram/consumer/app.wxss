page {
  background: #f5f6fa;
  font-size: 28rpx;
  color: #1f2937;
  -webkit-font-smoothing: antialiased;
}

.page {
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 6rpx 0;
  font-size: 26rpx;
}

.label {
  color: #6b7280;
}

.amount {
  color: #07c160;
  font-weight: 600;
}

.btn {
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 2.2;
  padding: 0 32rpx;
  margin: 0;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: #07c160;
  color: #ffffff;
}

.btn-danger {
  background: #ef4444;
  color: #ffffff;
}

.btn-outline {
  background: #ffffff;
  color: #07c160;
  border: 2rpx solid #07c160;
}

.btn-sm {
  font-size: 24rpx;
  line-height: 2;
  padding: 0 24rpx;
}

.btn-block {
  width: 100%;
}

.empty {
  text-align: center;
  color: #9ca3af;
  padding: 80rpx 0;
  font-size: 26rpx;
}

.hero {
  background: #07c160;
  color: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 20rpx;
}

.hero-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
}

.hero-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  opacity: 0.9;
}

.chip {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.chip.ok {
  background: #ecfdf5;
  color: #059669;
}

.chip.warn {
  background: #fff7ed;
  color: #ea580c;
}

.chip.info {
  background: #eff6ff;
  color: #2563eb;
}

.chip.danger {
  background: #fef2f2;
  color: #dc2626;
}

.chip.muted {
  background: #f3f4f6;
  color: #6b7280;
}

.form-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 8rpx;
}

.input {
  background: #f3f4f6;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
}

.tip {
  display: block;
  text-align: center;
  color: #9ca3af;
  font-size: 24rpx;
  padding: 16rpx 0;
}
