<view class="page">
  <view class="card" wx:if="{{tenantName}}">
    <text class="name">{{tenantName}}</text>
  </view>
  <view class="card" wx:for="{{items}}" wx:key="product_id">
    <view class="item-row">
      <view class="item-main">
        <text class="item-name">{{item.name}}</text>
        <text class="item-price">{{item.lineTotalText}}</text>
      </view>
      <qty-stepper value="{{item.quantity}}" min="0" data-index="{{index}}" bind:change="onQtyChange" />
    </view>
  </view>
  <view class="empty" wx:if="{{items.length === 0}}">
    <text>购物车为空</text>
    <button class="btn btn-primary" bindtap="goMenu">去点餐</button>
  </view>
  <view class="card" wx:if="{{items.length > 0}}">
    <view class="form-item" wx:if="{{requiresPin}}">
      <text class="form-label">桌台口令</text>
      <input class="input" password placeholder="请输入桌上的口令" bindinput="onPinInput" />
    </view>
    <view class="form-item">
      <text class="form-label">称呼（可选）</text>
      <input class="input" placeholder="方便服务员上菜时称呼" bindinput="onNameInput" />
    </view>
    <view class="total-row">
      <text class="label">合计</text>
      <text class="total-text">{{totalText}}</text>
    </view>
    <button class="btn btn-primary btn-block" bindtap="onSubmit" loading="{{submitting}}" disabled="{{submitting}}">提交订单</button>
  </view>
</view>
