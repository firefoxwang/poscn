.item-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-right: 16rpx;
}

.item-name {
  font-size: 30rpx;
  font-weight: 500;
}

.item-price {
  font-size: 28rpx;
  color: #07c160;
  margin-top: 8rpx;
}

.total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0 24rpx;
  border-top: 1rpx solid #f3f4f6;
}

.total-text {
  font-size: 40rpx;
  font-weight: 700;
  color: #07c160;
}
