.cat {
  margin-bottom: 8rpx;
}

.cat-title {
  font-size: 30rpx;
  font-weight: 600;
  padding: 16rpx 4rpx;
}

.item {
  display: flex;
  padding: 20rpx;
}

.item-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #f3f4f6;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.item-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.item-name {
  font-size: 30rpx;
  font-weight: 500;
}

.item-desc {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.item-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.item-price {
  color: #07c160;
  font-size: 30rpx;
  font-weight: 600;
}

.add-btn {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 50%;
  background: #07c160;
  color: #ffffff;
  font-size: 36rpx;
}

.cart-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #ffffff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.cart-info {
  flex: 1;
}

.cart-count {
  font-size: 26rpx;
  color: #6b7280;
  margin-right: 16rpx;
}

.cart-total {
  font-size: 34rpx;
  font-weight: 700;
  color: #07c160;
}

.cart-go {
  min-width: 200rpx;
}

.token-input {
  margin-top: 32rpx;
}
