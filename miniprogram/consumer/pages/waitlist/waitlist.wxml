<view class="page">
  <view wx:if="{{!tenantId}}" class="card">
    <view class="form-item">
      <text class="form-label">门店 ID</text>
      <input class="input" type="number" placeholder="输入门店 ID（扫码进点餐页可自动带入）" bindinput="onTenantIdInput" />
    </view>
  </view>
  <view class="hero" wx:if="{{tenantName}}">
    <text class="hero-title">{{tenantName}}</text>
    <text class="hero-sub">排队取号</text>
  </view>
  <view class="card" wx:if="{{!done}}">
    <view class="form-item">
      <text class="form-label">姓名</text>
      <input class="input" placeholder="您的姓名" bindinput="onNameInput" />
    </view>
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input class="input" placeholder="含国家区号，如 +8613800138000" bindinput="onPhoneInput" />
    </view>
    <view class="form-item">
      <text class="form-label">人数</text>
      <input class="input" type="number" value="{{partySize}}" bindinput="onPartyInput" />
    </view>
    <button class="btn btn-primary btn-block" bindtap="onSubmit" loading="{{submitting}}" disabled="{{submitting}}">开始排队</button>
  </view>
  <view class="card" wx:else>
    <view class="form-title">排队成功</view>
    <view class="row">
      <text class="label">排队号</text>
      <text>#{{done.id}}</text>
    </view>
    <view class="row">
      <text class="label">状态</text>
      <text>{{done.status === 'waiting' ? '等待叫号' : done.status}}</text>
    </view>
    <view class="row">
      <text class="label">人数</text>
      <text>{{done.party_size}} 人</text>
    </view>
    <button class="btn btn-outline btn-block" bindtap="onReset">再排一单</button>
  </view>
</view>
