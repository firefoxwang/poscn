<view class="page">
  <view class="card" wx:if="{{order}}">
    <view class="card-head">
      <text class="name">订单 #{{order.id}}</text>
      <status-chip type="order" status="{{order.status}}" />
    </view>
    <view class="row">
      <text class="label">桌台</text>
      <text>{{order.table_name}}</text>
    </view>
    <view class="row">
      <text class="label">下单时间</text>
      <text>{{order.createdText}}</text>
    </view>
    <view class="row" wx:if="{{order.customer_name}}">
      <text class="label">顾客</text>
      <text>{{order.customer_name}}</text>
    </view>
    <view class="row">
      <text class="label">金额</text>
      <text class="amount">{{order.totalText}}</text>
    </view>
    <view class="row" wx:if="{{order.notes}}">
      <text class="label">备注</text>
      <text>{{order.notes}}</text>
    </view>
  </view>

  <view class="card" wx:if="{{order}}">
    <view class="card-head">
      <text class="name">菜品明细</text>
    </view>
    <view class="item" wx:for="{{items}}" wx:key="id">
      <view class="item-main">
        <text class="item-name">{{item.product_name}} × {{item.quantity}}</text>
        <status-chip type="item" status="{{item.status}}" />
      </view>
      <view class="item-sub">
        <text>{{item.priceText}}</text>
        <text wx:if="{{item.notes}}" class="item-notes">{{item.notes}}</text>
      </view>
      <button
        wx:if="{{item.canAdvance}}"
        class="btn btn-primary btn-sm"
        data-id="{{item.id}}"
        bindtap="onAdvanceItem"
      >{{item.nextLabel}}</button>
    </view>
  </view>

  <view class="actions" wx:if="{{order && order.canPay}}">
    <button class="btn btn-primary" bindtap="onMarkPaid">标记已支付</button>
    <button class="btn btn-outline" bindtap="onFinish">完成订单</button>
  </view>

  <view class="empty" wx:if="{{!loading && !order}}">订单不存在或已被删除</view>
</view>
