<view class="page">
  <view class="card" wx:if="{{profile}}">
    <view class="card-head">
      <text class="name">{{profile.full_name || profile.email}}</text>
    </view>
    <view class="row">
      <text class="label">邮箱</text>
      <text>{{profile.email}}</text>
    </view>
    <view class="row" wx:if="{{roleLabel}}">
      <text class="label">角色</text>
      <text>{{roleLabel}}</text>
    </view>
    <view class="row" wx:if="{{profile.phone}}">
      <text class="label">手机号</text>
      <text>{{profile.phone}}</text>
    </view>
    <view class="row" wx:if="{{profile.binding}}">
      <text class="label">微信昵称</text>
      <text>{{profile.binding.nickname || '—'}}</text>
    </view>
    <view class="row" wx:if="{{profile.binding}}">
      <text class="label">微信手机号</text>
      <text>{{profile.binding.phone || '—'}}</text>
    </view>
  </view>
  <view class="actions">
    <button class="btn btn-danger btn-block" bindtap="onLogout">退出登录</button>
  </view>
</view>
